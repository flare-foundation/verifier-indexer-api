# Common config
# APP_BASE_PATH=                # (optional) The base path for the API endpoints, e.g. /api/v1

# Verifier config
VERIFIER_TYPE=doge              # doge | btc | xrp | web2 | eth | sgb | flr | base | hype
TESTNET=true                    # true | false
PORT=3100
API_KEYS=12345,abcdef,abc123

# Web2 config (only required for web2 verifier type)
WEB2_SOURCE_IDS=PublicWeb2,testIgnite

# EVM config (only required for evm verifier types: eth | sgb | flr | base | hype)
EVM_RPC=https://flare-api.flare.network/ext/C/rpc

# Indexer query config (only required for utxo/xrp verifier types: doge | btc | xrp)
DB_DATABASE=db
DB_USERNAME=user
DB_PASSWORD=pass
DB_HOST=127.0.0.1
DB_PORT=8080
NUMBER_OF_CONFIRMATIONS=6       # The number of confirmations required for a transaction to be considered valid
INDEXER_SERVER_PAGE_LIMIT=100   # The page size for indexer API queries when listing outputs
